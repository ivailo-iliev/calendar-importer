{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schedule.expanded.schema.json",
  "title": "Weekly Schedule Import Expanded Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timezone",
    "events"
  ],
  "properties": {
    "timezone": {
      "type": "string",
      "const": "Europe/Sofia"
    },
    "events": {
      "type": "array",
      "maxItems": 35,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "start",
              "end",
              "title"
            ],
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "start": {
                "type": "string",
                "pattern": "^\\d{2}:\\d{2}$"
              },
              "end": {
                "type": "string",
                "pattern": "^\\d{2}:\\d{2}$"
              },
              "title": {
                "type": "string",
                "minLength": 2
              },
              "group": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "title",
              "allDay"
            ],
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "endDate": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "allDay": {
                "const": true
              },
              "title": {
                "type": "string",
                "minLength": 2
              },
              "group": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    }
  },
  "$comment": "Expanded editor contract: top-level timezone/events. Timed events require date/start/end/title. All-day events require date/title/allDay:true with optional endDate. Optional group carries the visible group number or label. Titles are free-form strings at the schema level so prompt rules can allow either mapped dictionary titles or specific user-requested custom titles. The endDate field uses exclusive end-date semantics (same as Google Calendar all-day end.date). Missing endDate means a single-day all-day event; present endDate means a multi-day span from date inclusive to endDate exclusive."
}
